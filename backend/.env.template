# =============================================================================
# AMR Prediction System — Backend Environment Configuration
# =============================================================================
# 1. Copy this file:  cp .env.template .env
# 2. Fill in all values marked as REQUIRED
# 3. NEVER commit .env — it's in .gitignore
# =============================================================================

# --- Google Gemini API Key (REQUIRED) ---
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-api-key-here

# --- Gemini Model Configuration ---
GEMINI_MODEL_NAME=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/embedding-001

# --- Server ---
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_DEBUG=false

# --- CORS: comma-separated allowed origins (use * for all) ---
# In production, replace * with your Streamlit app URL, e.g.:
# ALLOW_ORIGINS=https://amr-frontend.onrender.com
ALLOW_ORIGINS=*

# --- File Paths (relative to backend/ directory) ---
MODELS_DIR=../ml_pipeline/models
PROCESSED_DATA_DIR=../data/processed

# --- Logging ---
LOG_LEVEL=INFO
